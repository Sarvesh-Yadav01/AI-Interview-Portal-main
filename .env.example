PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-interview-portal?retryWrites=true&w=majority

# AI API Key (Groq / Gemini / OpenAI)
# Free Groq: https://console.groq.com/keys
# Free Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=your_ai_api_key_here

# JWT and Session Secrets
JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_SECRET=replace_with_at_least_32_random_characters

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=adminpassword123

# Email SMTP Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=AI Interview Portal <your_email@gmail.com>