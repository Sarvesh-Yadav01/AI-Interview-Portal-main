{
  "name": "ai-interview-portal",
  "version": "2.0.0",
  "description": "Full MERN Stack AI-powered placement interview portal with webcam & screen proctoring, speech-to-text voice assessment, ATS resume scoring, admin analytics, and AI feedback.",
  "main": "backend/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/app.js",
    "backend": "nodemon backend/app.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"BACKEND,CLIENT\" -c \"cyan,magenta\" \"npm run backend\" \"npm run client\"",
    "build": "cd client && npm install && npm run build",
    "prod": "node backend/app.js"
  },
  "keywords": [
    "mern",
    "interview",
    "ai",
    "mongodb",
    "express",
    "react",
    "nodejs",
    "proctoring",
    "ats"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "openai": "^4.80.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
