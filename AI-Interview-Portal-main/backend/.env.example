PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-portal
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-interview-portal?retryWrites=true&w=majority

# ==============================================================================
# AI API KEYS (Choose any one of the following - Both options 1 and 2 are 100% FREE!):
# ==============================================================================
# OPTION 1 (Recommended & 100% Free): Groq Cloud (Ultra fast, no credit card required)
# Get free key from: https://console.groq.com/keys
# OPENAI_API_KEY=gsk_your_groq_api_key_here
#
# OPTION 2 (100% Free): Google Gemini via Google AI Studio (No credit card required)
# Get free key from: https://aistudio.google.com/apikey
# OPENAI_API_KEY=AIzaSy_your_gemini_api_key_here
#
# OPTION 3: Paid OpenAI Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides (if using custom endpoint or model):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=replace_with_a_strong_admin_password

# ==============================================================================
# SMTP Email Configuration (Optional - for real email sending)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=AI Interview Portal <your_email@example.com>
